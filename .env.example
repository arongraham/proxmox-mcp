# Proxmox VE 9.2.2 API, reached over Tailscale on port 8006.
# The process that runs this MCP must already be on that tailnet.
# Do not join Tailscale from a cloud build VM, and do not put an auth key here.
#
# MagicDNS name or the node's 100.x address. Replace the placeholders.
#   https://pve.<tailnet>.ts.net:8006
#   https://100.x.y.z:8006
PROXMOX_HOST=https://pve.<tailnet>.ts.net:8006

# Token id from Datacenter → Permissions → API Tokens. Format: user@realm!tokenid
PROXMOX_TOKEN_ID=cursor@pve!cursor

# Secret shown once when the token is created. Never commit the real value.
PROXMOX_TOKEN_SECRET=

# Optional. Node name on a one-node cluster. Leave empty to use the only node.
PROXMOX_NODE=

# Verify the TLS certificate. Default is true. Do not change the default in code.
# The stock Proxmox certificate matches the node's own hostname, not MagicDNS and
# not the 100.x address, so verification fails until you install a certificate
# for that name. Prefer the certificate. Set false only while this client stays
# on the tailnet.
PROXMOX_TLS_VERIFY=true

# Optional. Docker Engine API on a VM or LXC. Proxmox VE has no Docker API.
# Leave unset until that host exists. Example, on the tailnet only:
#   tcp://100.x.y.z:2375
DOCKER_HOST=
