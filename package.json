{
  "name": "proxmox-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "stdio MCP server for a Proxmox VE 9.2 node over the official REST API",
  "type": "module",
  "bin": {
    "proxmox-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc --noEmit && tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
